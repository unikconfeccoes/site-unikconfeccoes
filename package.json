{
  "name": "unik-site",
  "version": "1.0.0",
  "private": true,
  "description": "UNIK Confecções — uniformes premium desde 2016. Catálogo e orçamento.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "assets:logo": "node scripts/build-logo.mjs",
    "assets:images": "node scripts/build-images.mjs",
    "assets:prices": "python3 scripts/build-prices.py",
    "assets:all": "npm run assets:logo && npm run assets:prices && npm run assets:images"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.4",
    "sharp": "0.35.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
